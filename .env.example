# ============================================================
# Copy to .env.local and fill in. .env.local is gitignored.
#
# NEXT_PUBLIC_* values are exposed to the browser by design.
# Everything else stays server-side — never prefix a secret with
# NEXT_PUBLIC_.
# ============================================================

# ---------- Supabase ----------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key bypasses RLS entirely. It is NOT needed by this
# app — leave it unset unless you add an admin script, and never expose it.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Claude (item metadata auto-fill) ----------------
# console.anthropic.com → API keys. Turn auto-reload OFF on the billing
# page so a $5 top-up can never become a recurring charge.
# Roughly $0.0025 per item on Haiku 4.5 — about 25¢ for 100 items.
ANTHROPIC_API_KEY=

# ---------- Google Vision (online product search) -----------
# Requires a GCP project with billing enabled. Web Detection is free for
# the first 1000 requests/month, then ~$1.50/1000.
GOOGLE_VISION_API_KEY=

# ---------- Feature flags -----------------------------------
# Both default to off when the corresponding key above is blank, so the
# app degrades to manual entry rather than erroring.
NEXT_PUBLIC_ENABLE_AI_METADATA=true
NEXT_PUBLIC_ENABLE_ONLINE_SEARCH=true

# Background removal provider: "browser" (free, client-side WASM) or
# "fal" (paid, server-side — needs FAL_KEY).
NEXT_PUBLIC_BG_REMOVAL_PROVIDER=browser
# FAL_KEY=
